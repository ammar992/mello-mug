# Mellow Mug – copy to .env.local and fill in

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=mellow-mug

# Admin session signing secret (32+ random characters)
AUTH_SECRET=replace-with-a-long-random-string

# Initial admin account (npm run seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=Admin

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=mellow-mug
